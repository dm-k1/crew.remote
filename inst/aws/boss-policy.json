{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TheBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::__BUCKET__"
    },
    {
      "Sid": "TheBucketsFiles",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::__BUCKET__/*"
    },
    {
      "Sid": "FindTheWorkers",
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstances", "ec2:DescribeFleets", "ec2:DescribeSecurityGroupRules"],
      "Resource": "*"
    },
    {
      "Sid": "LetTheWorkersInOnlyOnBossGroups",
      "Effect": "Allow",
      "Action": ["ec2:AuthorizeSecurityGroupIngress", "ec2:RevokeSecurityGroupIngress"],
      "Resource": "arn:aws:ec2:*:*:security-group/*",
      "Condition": {"StringEquals": {"aws:ResourceTag/crew-remote-role": "boss"}}
    },
    {
      "Sid": "StopTheWorkersOfARun",
      "Effect": "Allow",
      "Action": ["ec2:DeleteFleets", "ec2:TerminateInstances"],
      "Resource": "*",
      "Condition": {"Null": {"aws:ResourceTag/crew-remote-run": "false"}}
    }
  ]
}
